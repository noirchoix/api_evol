AEA_ENVIRONMENT=production
AEA_API_PREFIX=/api/v1
AEA_DATA_DIR=/data
AEA_MAX_UPLOAD_BYTES=83886080
AEA_MAX_REPO_FILE_BYTES=2097152
AEA_MAX_REPO_FILES=5000
AEA_EXECUTION_TIMEOUT_SECONDS=90
AEA_CORS_ORIGINS=http://localhost:5173
# Safety interlock. Leave 0 on the API host. Enable only inside an isolated trusted runner.
AEA_ALLOW_LOCAL_EXECUTION=0
# Optional GitHub PR publishing. Keep token server-side only.
AEA_GITHUB_TOKEN=
AEA_GITHUB_API_URL=https://api.github.com
AEA_GITHUB_API_VERSION=2026-03-10
